# Node environment (development, production, or test)
NODE_ENV=development

# Server port to listen on
PORT=4000

# Server host interface to bind
HOST=127.0.0.1

# PostgreSQL connection string for Sequelize
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/easy_tools

# Secret key used for signing JWT tokens (min 32 characters)
JWT_SECRET=replace_with_a_secure_jwt_secret_at_least_32_characters_long

# Secret string used for cookie signing and encryption
COOKIE_SECRET=replace_with_a_secure_cookie_secret_at_least_32_characters_long

# Allowed frontend origin for CORS requests
CORS_ORIGIN=http://localhost:3000
